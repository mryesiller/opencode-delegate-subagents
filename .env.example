# Copy to .env and fill in locally. Never commit .env or real key values.
# OpenCode also supports `opencode auth login` / `/connect`, which stores
# credentials outside the repo. Env vars below are for config substitution
# in opencode.json (`{env:VAR}` references) and provider credential lookup.

# Z.AI Coding Plan (provider id: zai-coding-plan).
# Default coding / review model: zai-coding-plan/glm-5.3
# Official OpenCode / models.dev env name is ZHIPU_API_KEY (historical name).
# ZAI_API_KEY is accepted as a fallback (listed in opencode.json providers.env).
# Preferred: `opencode auth login` and choose "Z.AI Coding Plan" — then no env is required.
# Do not set an empty `{env:ZHIPU_API_KEY}` apiKey override if you use auth login;
# an unset env would replace the stored credential with an empty string.
ZHIPU_API_KEY=

# NVIDIA NIM (provider id: nvidia). Used by log-analyzer: nvidia/z-ai/glm-5.3-flash
NVIDIA_API_KEY=

# OpenRouter (provider id: openrouter). Optional fallback / extra free models.
# After connecting, run `opencode models` and pick an OpenRouter id.
OPENROUTER_API_KEY=
