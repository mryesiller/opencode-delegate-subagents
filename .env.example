# Copy to .env and fill in locally. Never commit .env or real key values.
# OpenCode also supports `opencode auth login` / `/connect`, which stores
# credentials outside the repo. Env vars below are for config substitution
# in opencode.json ({env:VAR} references).

# Z.AI (provider id: zai). Default coding model: zai/glm-5.3
# If you have a Z.AI Coding Plan, you can instead use provider zai-coding-plan
# after `opencode auth login`.
ZAI_API_KEY=

# NVIDIA NIM (provider id: nvidia). Used by log-analyzer: nvidia/z-ai/glm-5.3-flash
NVIDIA_API_KEY=

# OpenRouter (provider id: openrouter). Optional fallback / extra free models.
# After connecting, run `opencode models` and pick an OpenRouter id.
OPENROUTER_API_KEY=
