{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai/glm-5.3",
  "providers": {
    "zai": {
      "env": ["ZAI_API_KEY"],
      "settings": {
        "apiKey": "{env:ZAI_API_KEY}"
      }
    },
    "nvidia": {
      "env": ["NVIDIA_API_KEY"],
      "settings": {
        "apiKey": "{env:NVIDIA_API_KEY}"
      }
    },
    "openrouter": {
      "env": ["OPENROUTER_API_KEY"],
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}
