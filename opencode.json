{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.3",
  "providers": {
    "zai-coding-plan": {
      "env": ["ZHIPU_API_KEY", "ZAI_API_KEY"]
    },
    "nvidia": {
      "env": ["NVIDIA_API_KEY"],
      "settings": {
        "apiKey": "{env:NVIDIA_API_KEY}"
      }
    },
    "openrouter": {
      "env": ["OPENROUTER_API_KEY"],
      "settings": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  }
}
